<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- MAIN CHAT SCREEN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#131314"
        android:orientation="vertical">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="36dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <!-- Hamburger Sidebar Menu Button -->
            <ImageButton
                android:id="@+id/btnOpenDrawer"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="12dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Open Navigation Menu"
                android:padding="6dp"
                android:src="@drawable/ic_menu_drawer" />

            <!-- Model Switcher Badge -->
            <TextView
                android:id="@+id/btnModelSelector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gemini_pill"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:text="Kukki AI ✨"
                android:textColor="#E3E3E3"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- + New Chat Header Button -->
            <ImageButton
                android:id="@+id/btnHeaderNewChat"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="New Chat"
                android:padding="6dp"
                android:src="@drawable/ic_add_plus" />

        </LinearLayout>

        <!-- Center View (Gemini Welcome / Chat List) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Gemini Welcome State -->
            <ScrollView
                android:id="@+id/layoutWelcomeState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:contentDescription="Kukki Gemini Sparkle Logo"
                        android:src="@drawable/ic_gemini_sparkle" />

                    <TextView
                        android:id="@+id/tvWelcomeTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center"
                        android:text="Hello, Master Anshuman"
                        android:textColor="#D3E3FD"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="How can I assist you today?"
                        android:textColor="#8E918F"
                        android:textSize="16sp" />

                    <!-- Suggestion Chips Grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/chip1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_margin="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_chip_suggestion"
                                android:clickable="true"
                                android:focusable="true"
                                android:padding="16dp"
                                android:text="📞 Call someone on WhatsApp"
                                android:textColor="#E3E3E3"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/chip2"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_margin="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_chip_suggestion"
                                android:clickable="true"
                                android:focusable="true"
                                android:padding="16dp"
                                android:text="💬 Message on WhatsApp"
                                android:textColor="#E3E3E3"
                                android:textSize="14sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/chip3"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_margin="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_chip_suggestion"
                                android:clickable="true"
                                android:focusable="true"
                                android:padding="16dp"
                                android:text="💡 Who created Kukki?"
                                android:textColor="#E3E3E3"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/chip4"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_margin="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_chip_suggestion"
                                android:clickable="true"
                                android:focusable="true"
                                android:padding="16dp"
                                android:text="✨ Tell me a story"
                                android:textColor="#E3E3E3"
                                android:textSize="14sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </ScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvChat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Listening Overlay -->
        <LinearLayout
            android:id="@+id/cvListeningCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_listening_overlay"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivListeningMic"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_pulsing_mic"
                android:contentDescription="Active Listening"
                android:padding="10dp"
                android:src="@drawable/ic_mic" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kukki is listening..."
                    android:textColor="#8AB4F8"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Speak your request now"
                    android:textColor="#A1A1AA"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Attachment Preview Badge -->
        <LinearLayout
            android:id="@+id/layoutAttachmentPreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_attach_preview"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivAttachmentIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Attachment Preview"
                android:src="@android:drawable/ic_menu_gallery" />

            <TextView
                android:id="@+id/tvAttachmentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="200dp"
                android:text="photo.jpg"
                android:textColor="#ECECF1"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/btnRemoveAttachment"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@null"
                android:contentDescription="Remove attachment"
                android:src="@android:drawable/ic_menu_close_clear_cancel" />

        </LinearLayout>

        <!-- Input Bar Capsule -->
        <LinearLayout
            android:id="@+id/layoutBottomContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:id="@+id/layoutInputBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gemini_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp">

                <ImageButton
                    android:id="@+id/btnAttach"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@null"
                    android:contentDescription="Attach Image or Document"
                    android:padding="6dp"
                    android:src="@drawable/ic_add_plus" />

                <EditText
                    android:id="@+id/etMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="center_vertical|start"
                    android:hint="Ask Kukki..."
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="4"
                    android:minHeight="40dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8E918F"
                    android:textCursorDrawable="@drawable/bg_cursor_white"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/btnMic"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@null"
                    android:contentDescription="Voice Input"
                    android:padding="6dp"
                    android:src="@drawable/ic_mic" />

                <ImageButton
                    android:id="@+id/btnSend"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_send_button"
                    android:contentDescription="Send Message"
                    android:padding="8dp"
                    android:src="@drawable/ic_send_arrow" />

            </LinearLayout>
        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="10dp"
            android:text="Kukki AI can make mistakes. Check important info."
            android:textColor="#8E918F"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- LEFT SIDEBAR: CHAT HISTORY DRAWER -->
    <LinearLayout
        android:id="@+id/drawerSidebar"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#1E1F22"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingTop="36dp">

        <!-- Sidebar Header: + New Chat Button -->
        <LinearLayout
            android:id="@+id/btnSidebarNewChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_gemini_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="New Chat Icon"
                android:src="@drawable/ic_add_plus" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="New Chat"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="Recent Conversations"
            android:textColor="#8E918F"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- History Items List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChatHistory"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2B2D31" />

        <!-- Bottom Action Bar in Drawer -->
        <LinearLayout
            android:id="@+id/btnSidebarClearHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Clear History"
                android:src="@android:drawable/ic_menu_delete" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Clear All Conversations"
                android:textColor="#F2B8B5"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>